# Copy to backend/.env and fill in. Never commit the real .env.

# Required. Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# SQLite by default; for PostgreSQL use e.g.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/catotag
DATABASE_URL=sqlite:///./catotag.db

# Log every SQL statement (true/false)
SQL_ECHO=false

# Login lifetime; long enough to outlast a match
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# Development only: also allow the app opened from a phone on the local network.
# Leave empty in production.
CORS_ORIGIN_REGEX=

# Interactive API docs at /docs (set false in production)
ENABLE_DOCS=true
