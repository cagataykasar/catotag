# Copy to frontend/.env.local. Values are baked into the build and visible to users: no secrets here.

# Backend base URL. Leave unset in development: the app then calls port 8000 on the same host
# that served the page (works for localhost and for phones on the local network).
# Set it for production, e.g. REACT_APP_API_URL=https://api.example.com
# REACT_APP_API_URL=
